---
layout: base.vto
---
{{ set i = categories.findIndex((c) => c.url === url) }}
{{ set cat = categories[i] }}
{{ set prev = categories[(i - 1 + categories.length) % categories.length] }}
{{ set next = categories[(i + 1) % categories.length] }}
<div class="page" style="--accent: var(--accent-{{ i % 4 }})">
  <nav class="topbar" aria-label="Navegación">
    <a href="/" class="brand">guía de mi</a>
    <a href="/" class="kicker">← Índice</a>
  </nav>

  <header class="cat-head">
    <p class="kicker"><span class="dot" aria-hidden="true"></span>{{ cat.number }} / {{ categories.length }}</p>
    <h1>{{ cat.title }}</h1>
    <p class="kicker">{{ cat.items.length }} direcciones</p>
  </header>

  <ul class="shops">
    {{ for item of cat.items }}
    <li>
      <a href="{{ item.url }}" target="_blank" rel="noopener">
        <span class="shop-name">{{ item.name }}</span>
        {{ if item.description }}<span class="shop-desc">{{ item.description }}</span>{{ /if }}
        <span class="shop-source">{{ item.source }} <span aria-hidden="true">↗</span></span>
      </a>
    </li>
    {{ /for }}
  </ul>

  <nav class="pager" aria-label="Otras categorías">
    <a href="{{ prev.url }}" class="pager-prev">
      <span class="kicker">← Anterior</span>
      <span class="pager-title">{{ prev.title }}</span>
    </a>
    <a href="{{ next.url }}" class="pager-next">
      <span class="kicker">Siguiente →</span>
      <span class="pager-title">{{ next.title }}</span>
    </a>
  </nav>
</div>
