---
layout: base.vto
pageTitle: Guía de mi
description: Tiendas, marcas y talleres pequeños, ordenados por categoría.
---
<main class="home">
  <header class="home-cover">
    <img src="{{ cover }}" alt="Guía de mi: collage con una concha, una mano, un jarrón y un cuaderno" width="1349" height="1687">
  </header>

  <section class="index" aria-labelledby="index-title">
    <div class="index-head">
      <h1 id="index-title" class="kicker">Índice</h1>
      <p class="kicker">{{ categories.length }} categorías · {{ total }} direcciones</p>
    </div>
    <ol class="index-list">
      {{ for cat of categories }}
      <li>
        <a href="{{ cat.url }}" style="--accent: var(--accent-{{ (cat.number - 1) % 4 }})">
          <span class="index-number">{{ cat.number }}</span>
          <span class="index-title">{{ cat.title }}</span>
          <span class="index-count">{{ cat.items.length }}</span>
        </a>
      </li>
      {{ /for }}
    </ol>
  </section>
</main>
